{
  "expo": {
    "name": "EDIYA_MEJANG",
    "slug": "ediyamejang",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "ediyamejang",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.branway.ediyamejang",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#004B93"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#004B93",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "영수증과 주문표를 촬영하기 위해 카메라 권한이 필요합니다.",
          "photosPermission": "메뉴, 매장 운영 이미지, 영수증과 주문표를 등록하기 위해 사진 접근 권한이 필요합니다.",
          "microphonePermission": false
        }
      ],
      "expo-mail-composer"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b6264565-e8ea-434a-94b2-fe0d1d313ddc"
      }
    },
    "owner": "branway"
  }
}
